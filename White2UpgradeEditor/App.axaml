<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="White2UpgradeEditor.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/><Setter Property="Background" Value="#0B0F17"/><Setter Property="Foreground" Value="#E8ECF4"/></Style>
    <Style Selector="Button"><Setter Property="Background" Value="#202B3B"/><Setter Property="Foreground" Value="#E8ECF4"/><Setter Property="BorderBrush" Value="#344258"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#4F7CFF"/><Setter Property="BorderBrush" Value="#4F7CFF"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Foreground" Value="#AAB5C7"/></Style>
    <Style Selector="Button.nav:pointerover"><Setter Property="Background" Value="#192335"/><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style Selector="TextBox"><Setter Property="Background" Value="#111927"/><Setter Property="Foreground" Value="#E8ECF4"/><Setter Property="BorderBrush" Value="#2B394E"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="9,7"/></Style>
    <Style Selector="ListBox"><Setter Property="Background" Value="#0F1622"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#111927"/><Setter Property="BorderBrush" Value="#202D40"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8794A9"/></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F3F6FC"/></Style>
  </Application.Styles>
</Application>
